# Stockroom environment — copy this file to `.env` and fill in real
# values. Never commit `.env` (it's in .gitignore).

# REQUIRED in production. 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_64_hex_string

# Optional. Defaults: NODE_ENV unset, JWT_TTL='8h', PORT=3000.
# NODE_ENV=development
# JWT_TTL=8h
# PORT=3000

# Dev-mode escape hatch — set to 1 to allow the server to start without
# JWT_SECRET (it generates an ephemeral one per process). DO NOT set
# this in production.
# SM_ALLOW_INSECURE_SECRET=1

# ---- AI assistant (Stockie) ---------------------------------------
# Stockroom has a built-in AI assistant ("Stockie") that runs through
# any OpenAI-compatible chat-completions endpoint. The recommended
# setup is to point at OmniRoute (your local LLM router) so you don't
# need a separate cloud account. All three values are required for the
# assistant widget to appear in the UI; if any is missing, the widget
# shows "not configured" and the server returns 503 on assistant calls.
#
# Generate an OmniRoute API key in the dashboard (or reuse one you
# already have), then:
OMNIROUTE_BASE_URL=https://your-omnirite-host/v1
OMNIROUTE_MODEL=free-stack
OMNIROUTE_API_KEY=replace_me_with_a_real_key
