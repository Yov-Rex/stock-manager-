# Stockroom environment — copy this file to `.env` and fill in real
# values. Never commit `.env` (it's in .gitignore).

# REQUIRED in production. 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_64_hex_string

# Optional. Defaults: NODE_ENV unset, JWT_TTL='8h', PORT=3000.
# NODE_ENV=development
# JWT_TTL=8h
# PORT=3000

# Dev-mode escape hatch — set to 1 to allow the server to start without
# JWT_SECRET (it generates an ephemeral one per process). DO NOT set
# this in production.
# SM_ALLOW_INSECURE_SECRET=1
